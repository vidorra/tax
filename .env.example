# Database: één SQLite-bestand, geen databaseserver. Zonder DATABASE_PATH is dat data/ibcalculator.db in de werkmap
# (git negeert data/); npm run db:migrate maakt het aan. In de container zet de image /app/data/ibcalculator.db,
# daar hoef je niets te zetten. De map moet schrijfbaar zijn: SQLite zet er ook de bestanden -wal en -shm neer.
# DATABASE_PATH=./data/ibcalculator.db
# Sessies (minimaal 32 tekens, willekeurig)
AUTH_SECRET=vervang-door-een-lange-willekeurige-string
# Versleuteling van dossiers: 32 bytes als base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DOSSIER_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Umami (optioneel, cookieless): het script staat alleen op de pagina als beide variabelen zijn gezet, en de CSP
# staat de host uit NEXT_PUBLIC_UMAMI_SRC toe. Ontbreekt een van de twee, dan geen statistiek. NEXT_PUBLIC_UMAMI_SRC
# is de URL van het script op je eigen Umami-server, bijvoorbeeld https://stats.example.nl/script.js.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
# Aantal vertrouwde proxy-hops voor X-Forwarded-For (één reverse proxy zoals nginx = 1; zet 2 met Cloudflare ervoor)
TRUSTED_PROXY_HOPS=1
# Commit-hash voor /api/health (optioneel)
GIT_SHA=
# Moneybird: geen variabelen meer. Elk account voegt in het dossier zelf een token toe (versleuteld opgeslagen,
# per persoon A of B). Een oud MONEYBIRD_TOKEN wordt bij de start één keer overgezet naar de eerste beheerder.
# Mail (back-up en uitnodigingen voor nieuwe accounts).
# Back-up (optioneel): op 1 februari en 1 augustus een versleutelde back-up van de database naar BACKUP_MAIL_TO.
# MAIL_FROM moet een adres zijn op een domein dat bij je mailprovider is geverifieerd (bij Resend: Domains).
# Resend gaat voor; zonder RESEND_API_KEY mailt de server via SMTP (poort standaard 587, bij 465 met TLS).
BACKUP_MAIL_TO=
MAIL_FROM=noreply@example.nl
MAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
